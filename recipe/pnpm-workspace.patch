From 89969d5905218766d3ba07d1d8b70e7aafc06737 Mon Sep 17 00:00:00 2001
From: Tim Paine <t.paine154@gmail.com>
Date: Tue, 1 Sep 2026 17:25:29 -0400
Subject: [PATCH] Approve build scripts for fontawesome and unrs-resolver

pnpm refuses to run dependency build scripts unless they are approved and
fails the install with ERR_PNPM_IGNORED_BUILDS, which breaks the hatch-js
build.
---
 js/pnpm-workspace.yaml | 3 +++
 1 file changed, 3 insertions(+)
 create mode 100644 js/pnpm-workspace.yaml

diff --git a/js/pnpm-workspace.yaml b/js/pnpm-workspace.yaml
new file mode 100644
index 0000000..389d195
--- /dev/null
+++ b/js/pnpm-workspace.yaml
@@ -0,0 +1,3 @@
+allowBuilds:
+  '@fortawesome/fontawesome-free': true
+  unrs-resolver: true
